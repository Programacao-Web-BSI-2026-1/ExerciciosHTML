<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulário de Contato</title>
    <link rel="stylesheet" href="estiloForm.css">
</head>
<body>

    <main class="container-form">
        <header>
            <h2>Entre em Contato</h2>
            <p>Preencha os dados abaixo e nos envie sua mensagem.</p>
        </header>

        <form action="#" method="POST" class="form-contato">
            <div class="grupo-input">
                <label for="nome">Nome Completo</label>
                <input type="text" id="nome" name="nome" placeholder="Ex: João da Silva" required>
            </div>

            <div class="grupo-input">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" placeholder="seuemail@dominio.com" required>
            </div>

            <div class="grupo-input">
                <label for="mensagem">Mensagem</label>
                <!-- Introdução ao textarea para textos longos -->
                <textarea id="mensagem" name="mensagem" rows="5" placeholder="Escreva sua mensagem aqui..." required></textarea>
            </div>

            <div class="acoes-form">
                <!-- Apenas um botão principal de ação -->
                <button type="submit" class="btn-enviar">Enviar Mensagem</button>
            </div>
        </form>
    </main>

</body>
</html>




* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #f3f4f6;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
}


.container-form {
    background-color: #ffffff;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    max-width: 500px;
    width: 100%;
    padding: 30px;
}

.container-form header {
    margin-bottom: 20px;
}

.container-form header h2 {
    margin: 0 0 6px 0;
    font-size: 1.5em;
}

.container-form header p {
    margin: 0;
    color: #6b7280;
    font-size: 0.95em;
}

.form-contato {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.grupo-input {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.grupo-input label {
    font-weight: bold;
    font-size: 0.9em;
}


input,
textarea {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 12px;
    font-size: 1em;
    font-family: inherit;
    width: 100%;
}

textarea {
    resize: vertical;
}


input:focus,
textarea:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
}


input[type="email"]:not(:placeholder-shown):invalid {
    border-color: #ef4444;
}

input[type="email"]:not(:placeholder-shown):valid {
    border-color: #22c55e;
}


.acoes-form {
    display: flex;
    justify-content: flex-end;
}

.btn-enviar {
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-weight: bold;
    font-size: 1em;
    color: #ffffff;
    background-color: #1d4ed8;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.1s;
}

.btn-enviar:hover {
    background-color: #1e3a8a;
}

.btn-enviar:active {
    transform: scale(0.98);
}
